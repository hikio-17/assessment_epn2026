{
  "name": "assessment",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "PORT=${PORT:-4000} react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "db:up": "docker compose up -d db --wait",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "yarn db:up && yarn db:seed",
    "db:psql": "docker exec -it peopleops-db psql -U assessment -d assessment",
    "db:down": "docker compose down",
    "smoke:employee": "tsx scripts/smoke-employee.ts",
    "pretest": "docker compose up -d db --wait",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit --reporter=verbose",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-router/node": "^8.5.3",
    "@react-router/serve": "^8.5.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "isbot": "^5.2.4",
    "lucide-react": "^1.81.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "react-top-loading-bar": "3.0.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
